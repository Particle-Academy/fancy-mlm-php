{
  "suite": "mlm/referral-attribution",
  "status": "proposed",
  "notes": [
    "PROPOSED for fancy-conformance, not yet promoted. This file is carried byte-identically by particle-academy/fancy-mlm (tests/fixtures/) and @particle-academy/fancy-mlm (src/fixtures/); both suites assert its SHA-256 (CRLF folded to LF) so an edit on one side only goes red there.",
    "Times are RFC 3339 instants in UTC, second precision. Ranges are [from, to): from inclusive, to exclusive.",
    "decide: the attribution window is INCLUSIVE at both ends (signupAt - windowSeconds <= scannedAt <= signupAt). A code must be usable AT SIGNUP: active and (no expiry or signupAt < expiresAt). Candidates are walked in policy order (first_touch = oldest first, last_touch = newest first; ties keep store order) and the first eligible one wins; when none is eligible the reason is the rejection of the FIRST candidate in policy order.",
    "scanSequence: a scan is a duplicate when the same code + session hash has a RECORDED scan with scannedAt > at - dedupeSeconds. Exactly dedupeSeconds later is a new scan.",
    "stats: conversionRate = signups / uniqueSessions, 0 when uniqueSessions is 0. It can exceed 1 when a signup in the range came from a scan before it. Rows sort by key, byte order."
  ],
  "cases": [
    { "id": "0001-hmac-rfc4231-tc2", "fn": "hashSession", "title": "Known-answer: RFC 4231 test case 2 proves this is HMAC-SHA256, not a bare digest", "input": { "key": "Jefe", "sessionId": "what do ya want for nothing?" }, "expected": { "hash": "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843" } },
    { "id": "0002-hmac-key-a", "fn": "hashSession", "title": "A session id under key A", "input": { "key": "app-secret-a", "sessionId": "sess-123" }, "expected": { "hash": "e64241cfd553b7425274fd184d35e06b3454eede2b839279f621b31c1aac6da1" } },
    { "id": "0003-hmac-key-b", "fn": "hashSession", "title": "The same session id under key B hashes differently, so a leaked table cannot be joined across apps", "input": { "key": "app-secret-b", "sessionId": "sess-123" }, "expected": { "hash": "d8a180632e885a527788f37efb9a4731554d93038ee4fc72187932f6596df5d9" }, "notes": "Unkeyed sha256('sess-123') is c8d9cf28...2fa4; an implementation returning that fails every hash row." },
    { "id": "0004-hmac-utf8", "fn": "hashSession", "title": "Non-ASCII session ids hash their UTF-8 bytes", "input": { "key": "app-secret-a", "sessionId": "séance-☃" }, "expected": { "hash": "4e00f24406be3617972b360e31420af1fabf00753fbc03cd6ae7f49c03402ba9" } },
    { "id": "0005-hmac-empty-key-refused", "fn": "hashSession", "title": "An empty key is refused: an unkeyed hash is reversible by dictionary", "input": { "key": "", "sessionId": "sess-123" }, "expected": { "refused": "key" } },
    { "id": "0006-hmac-empty-session-refused", "fn": "hashSession", "title": "An empty session id is refused", "input": { "key": "app-secret-a", "sessionId": "" }, "expected": { "refused": "sessionId" } },

    { "id": "0101-scope-string", "fn": "scopeKey", "title": "A string scope is opaque and passes through", "input": { "scope": "region-7" }, "expected": { "key": "region-7" } },
    { "id": "0102-scope-tuple", "fn": "scopeKey", "title": "A tuple is RFC 3986-encoded per part and joined with a colon", "input": { "scope": ["team:alpha", "season 3"] }, "expected": { "key": "team%3Aalpha:season%203" } },
    { "id": "0103-scope-tuple-reserved", "fn": "scopeKey", "title": "Sub-delims are encoded the same way in both languages (encodeURIComponent leaves these alone)", "input": { "scope": ["!*'()~"] }, "expected": { "key": "%21%2A%27%28%29~" } },
    { "id": "0104-scope-tuple-utf8", "fn": "scopeKey", "title": "Non-ASCII parts encode their UTF-8 bytes", "input": { "scope": ["é"] }, "expected": { "key": "%C3%A9" } },
    { "id": "0105-scope-empty-refused", "fn": "scopeKey", "title": "An empty string scope is refused", "input": { "scope": "" }, "expected": { "refused": "scope" } },
    { "id": "0106-scope-empty-tuple-refused", "fn": "scopeKey", "title": "An empty tuple is refused", "input": { "scope": [] }, "expected": { "refused": "scope" } },
    { "id": "0107-scope-empty-part-refused", "fn": "scopeKey", "title": "A tuple with an empty part is refused", "input": { "scope": ["a", ""] }, "expected": { "refused": "scope" } },
    { "id": "0108-scope-too-long-refused", "fn": "scopeKey", "title": "A key over 191 bytes is refused (the indexed column width)", "input": { "scope": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }, "expected": { "refused": "scope" } },

    { "id": "0201-code-normalize", "fn": "normalizeCode", "title": "Codes are case-insensitive and trimmed", "input": { "code": "  ABCDEFGH23456789 " }, "expected": { "code": "abcdefgh23456789" } },
    { "id": "0202-code-ambiguous-letters", "fn": "normalizeCode", "title": "i, l, o and u are not in the alphabet", "input": { "code": "abcdefghijklmnop" }, "expected": { "code": null } },
    { "id": "0203-code-too-short", "fn": "normalizeCode", "title": "Eleven characters is below the 12-character floor", "input": { "code": "abcdefgh234" }, "expected": { "code": null } },
    { "id": "0204-code-floor", "fn": "normalizeCode", "title": "Twelve characters is accepted", "input": { "code": "abcdefgh2345" }, "expected": { "code": "abcdefgh2345" } },
    { "id": "0205-code-ceiling", "fn": "normalizeCode", "title": "Sixty-four characters is accepted", "input": { "code": "0123456789abcdefghjkmnpqrstvwxyz0123456789abcdefghjkmnpqrstvwxyz" }, "expected": { "code": "0123456789abcdefghjkmnpqrstvwxyz0123456789abcdefghjkmnpqrstvwxyz" } },
    { "id": "0206-code-over-ceiling", "fn": "normalizeCode", "title": "Sixty-five characters is refused", "input": { "code": "0123456789abcdefghjkmnpqrstvwxyz0123456789abcdefghjkmnpqrstvwxyz0" }, "expected": { "code": null } },
    { "id": "0207-code-url-junk", "fn": "normalizeCode", "title": "Anything outside the alphabet, such as a path or query, is refused rather than stripped", "input": { "code": "abcdefgh2345/../x" }, "expected": { "code": null } },
    { "id": "0208-code-kelvin-sign", "fn": "normalizeCode", "title": "Lowercasing is ASCII-only: KELVIN SIGN (U+212A) is not k", "input": { "code": "Kbcdefgh2345678" }, "expected": { "code": null }, "notes": "JavaScript toLowerCase() maps U+212A to ASCII k, so a port using it accepts a code PHP strtolower() refuses." },
    { "id": "0209-code-nbsp-not-trimmed", "fn": "normalizeCode", "title": "Trimming is PHP trim(): a no-break space is not whitespace to strip", "input": { "code": " abcdefgh23456789" }, "expected": { "code": null }, "notes": "JavaScript trim() strips U+00A0; PHP trim() strips only space, tab, LF, CR, NUL and vertical tab." },
    { "id": "0210-code-ascii-whitespace-trimmed", "fn": "normalizeCode", "title": "Tab and newline are trimmed", "input": { "code": "\tabcdefgh23456789\n" }, "expected": { "code": "abcdefgh23456789" } },

    { "id": "0301-first-touch-single", "fn": "decide", "title": "One scan in the window attributes its code's owner",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": true, "sponsorMemberId": "o1", "code": "aaaaaaaaaaaaaaaa", "scanId": "1", "reason": "attributed" } },
    { "id": "0302-first-touch-earliest", "fn": "decide", "title": "First touch takes the oldest scan",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [
          { "scanId": "1", "scannedAt": "2026-11-01T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null },
          { "scanId": "2", "scannedAt": "2026-11-03T12:00:00Z", "code": "bbbbbbbbbbbbbbbb", "codeMemberId": "o2", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": true, "sponsorMemberId": "o1", "code": "aaaaaaaaaaaaaaaa", "scanId": "1", "reason": "attributed" } },
    { "id": "0303-last-touch-latest", "fn": "decide", "title": "Last touch takes the newest scan",
      "input": { "policy": { "model": "last_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [
          { "scanId": "1", "scannedAt": "2026-11-01T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null },
          { "scanId": "2", "scannedAt": "2026-11-03T12:00:00Z", "code": "bbbbbbbbbbbbbbbb", "codeMemberId": "o2", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": true, "sponsorMemberId": "o2", "code": "bbbbbbbbbbbbbbbb", "scanId": "2", "reason": "attributed" } },
    { "id": "0304-outside-window", "fn": "decide", "title": "A scan one second older than the window attributes nothing",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 86400 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-03T11:59:59Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": false, "sponsorMemberId": null, "code": null, "scanId": null, "reason": "no_scan" } },
    { "id": "0305-window-edge-inclusive", "fn": "decide", "title": "A scan exactly windowSeconds before signup is inside the window",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 86400 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": true, "sponsorMemberId": "o1", "code": "aaaaaaaaaaaaaaaa", "scanId": "1", "reason": "attributed" } },
    { "id": "0306-scan-after-signup", "fn": "decide", "title": "A scan after the signup instant is ignored",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 86400 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-04T12:00:01Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": false, "sponsorMemberId": null, "code": null, "scanId": null, "reason": "no_scan" } },
    { "id": "0307-revoked", "fn": "decide", "title": "A revoked code attributes nothing",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "revoked", "expiresAt": null } ] },
      "expected": { "attributed": false, "sponsorMemberId": null, "code": null, "scanId": null, "reason": "code_inactive" } },
    { "id": "0308-expired-at-signup", "fn": "decide", "title": "A code expiring exactly at the signup instant has expired (expiry is exclusive)",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": "2026-11-04T12:00:00Z" } ] },
      "expected": { "attributed": false, "sponsorMemberId": null, "code": null, "scanId": null, "reason": "code_inactive" } },
    { "id": "0309-not-yet-expired", "fn": "decide", "title": "A code expiring one second after signup still attributes",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": "2026-11-04T12:00:01Z" } ] },
      "expected": { "attributed": true, "sponsorMemberId": "o1", "code": "aaaaaaaaaaaaaaaa", "scanId": "1", "reason": "attributed" } },
    { "id": "0310-first-touch-falls-through", "fn": "decide", "title": "When the first touch's code was revoked, the next eligible scan wins",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [
          { "scanId": "1", "scannedAt": "2026-11-01T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "revoked", "expiresAt": null },
          { "scanId": "2", "scannedAt": "2026-11-03T12:00:00Z", "code": "bbbbbbbbbbbbbbbb", "codeMemberId": "o2", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": true, "sponsorMemberId": "o2", "code": "bbbbbbbbbbbbbbbb", "scanId": "2", "reason": "attributed" } },
    { "id": "0311-last-touch-falls-through", "fn": "decide", "title": "When the last touch's code expired, the previous eligible scan wins",
      "input": { "policy": { "model": "last_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [
          { "scanId": "1", "scannedAt": "2026-11-01T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null },
          { "scanId": "2", "scannedAt": "2026-11-03T12:00:00Z", "code": "bbbbbbbbbbbbbbbb", "codeMemberId": "o2", "scope": "x", "status": "active", "expiresAt": "2026-11-04T00:00:00Z" } ] },
      "expected": { "attributed": true, "sponsorMemberId": "o1", "code": "aaaaaaaaaaaaaaaa", "scanId": "1", "reason": "attributed" } },
    { "id": "0312-self-referral", "fn": "decide", "title": "A member scanning their own code is refused",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "o1", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": false, "sponsorMemberId": null, "code": null, "scanId": null, "reason": "self_referral" } },
    { "id": "0313-direct-cycle", "fn": "decide", "title": "The code's owner is sponsored by the member: attributing would close a cycle",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "m", "signupAt": "2026-11-04T12:00:00Z", "sponsors": { "o1": "m" },
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": false, "sponsorMemberId": null, "code": null, "scanId": null, "reason": "cycle" } },
    { "id": "0314-deep-cycle", "fn": "decide", "title": "A cycle three levels up is still a cycle",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "m", "signupAt": "2026-11-04T12:00:00Z", "sponsors": { "o1": "x1", "x1": "x2", "x2": "m" },
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": false, "sponsorMemberId": null, "code": null, "scanId": null, "reason": "cycle" } },
    { "id": "0315-unrelated-loop-terminates", "fn": "decide", "title": "A pre-existing loop above the owner that never reaches the member terminates and attributes",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "m", "signupAt": "2026-11-04T12:00:00Z", "sponsors": { "o1": "x1", "x1": "x2", "x2": "x1" },
        "candidates": [ { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": true, "sponsorMemberId": "o1", "code": "aaaaaaaaaaaaaaaa", "scanId": "1", "reason": "attributed" } },
    { "id": "0316-tie-first-touch", "fn": "decide", "title": "Same-second scans: first touch keeps store order",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [
          { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null },
          { "scanId": "2", "scannedAt": "2026-11-03T12:00:00Z", "code": "bbbbbbbbbbbbbbbb", "codeMemberId": "o2", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": true, "sponsorMemberId": "o1", "code": "aaaaaaaaaaaaaaaa", "scanId": "1", "reason": "attributed" } },
    { "id": "0317-tie-last-touch", "fn": "decide", "title": "Same-second scans: last touch takes the later-stored one",
      "input": { "policy": { "model": "last_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [
          { "scanId": "1", "scannedAt": "2026-11-03T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "active", "expiresAt": null },
          { "scanId": "2", "scannedAt": "2026-11-03T12:00:00Z", "code": "bbbbbbbbbbbbbbbb", "codeMemberId": "o2", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": true, "sponsorMemberId": "o2", "code": "bbbbbbbbbbbbbbbb", "scanId": "2", "reason": "attributed" } },
    { "id": "0318-reason-follows-policy-order", "fn": "decide", "title": "Nothing eligible: the reason is the first candidate's in policy order",
      "input": { "policy": { "model": "last_touch", "windowSeconds": 2592000 }, "memberId": "o2", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {},
        "candidates": [
          { "scanId": "1", "scannedAt": "2026-11-01T12:00:00Z", "code": "aaaaaaaaaaaaaaaa", "codeMemberId": "o1", "scope": "x", "status": "revoked", "expiresAt": null },
          { "scanId": "2", "scannedAt": "2026-11-03T12:00:00Z", "code": "bbbbbbbbbbbbbbbb", "codeMemberId": "o2", "scope": "x", "status": "active", "expiresAt": null } ] },
      "expected": { "attributed": false, "sponsorMemberId": null, "code": null, "scanId": null, "reason": "self_referral" } },
    { "id": "0319-no-candidates", "fn": "decide", "title": "No scans at all",
      "input": { "policy": { "model": "first_touch", "windowSeconds": 2592000 }, "memberId": "new", "signupAt": "2026-11-04T12:00:00Z", "sponsors": {}, "candidates": [] },
      "expected": { "attributed": false, "sponsorMemberId": null, "code": null, "scanId": null, "reason": "no_scan" } },

    { "id": "0401-dedupe-sequence", "fn": "scanSequence", "title": "Refreshes inside the dedupe window are not recorded; exactly dedupeSeconds later is a new scan",
      "input": { "dedupeSeconds": 1800,
        "codes": [ { "code": "aaaaaaaaaaaaaaaa", "memberId": "1", "scope": "x", "status": "active", "expiresAt": null } ],
        "steps": [
          { "at": "2026-11-04T10:00:00Z", "code": "aaaaaaaaaaaaaaaa", "sessionId": "s" },
          { "at": "2026-11-04T10:10:00Z", "code": "aaaaaaaaaaaaaaaa", "sessionId": "s" },
          { "at": "2026-11-04T10:29:59Z", "code": "AAAAAAAAAAAAAAAA", "sessionId": "s" },
          { "at": "2026-11-04T10:30:00Z", "code": "aaaaaaaaaaaaaaaa", "sessionId": "s" },
          { "at": "2026-11-04T10:31:00Z", "code": "aaaaaaaaaaaaaaaa", "sessionId": "t" },
          { "at": "2026-11-04T10:45:00Z", "code": "aaaaaaaaaaaaaaaa", "sessionId": "s" } ] },
      "expected": { "results": ["recorded", "duplicate", "duplicate", "recorded", "recorded", "duplicate"] } },
    { "id": "0402-inactive-and-unknown", "fn": "scanSequence", "title": "Revoked, expired, unknown and malformed codes record nothing",
      "input": { "dedupeSeconds": 1800,
        "codes": [
          { "code": "aaaaaaaaaaaaaaaa", "memberId": "1", "scope": "x", "status": "revoked", "expiresAt": null },
          { "code": "bbbbbbbbbbbbbbbb", "memberId": "1", "scope": "x", "status": "active", "expiresAt": "2026-11-04T10:00:00Z" },
          { "code": "cccccccccccccccc", "memberId": "1", "scope": "x", "status": "active", "expiresAt": "2026-11-04T10:00:01Z" } ],
        "steps": [
          { "at": "2026-11-04T10:00:00Z", "code": "aaaaaaaaaaaaaaaa", "sessionId": "s" },
          { "at": "2026-11-04T10:00:00Z", "code": "bbbbbbbbbbbbbbbb", "sessionId": "s" },
          { "at": "2026-11-04T10:00:00Z", "code": "cccccccccccccccc", "sessionId": "s" },
          { "at": "2026-11-04T10:00:00Z", "code": "dddddddddddddddd", "sessionId": "s" },
          { "at": "2026-11-04T10:00:00Z", "code": "not a code", "sessionId": "s" } ] },
      "expected": { "results": ["code_inactive", "code_inactive", "recorded", "unknown_code", "unknown_code"] } },

    { "id": "0501-stats-by-code", "fn": "stats", "title": "Per code: scans, unique sessions, signups and conversion over [from, to)",
      "input": { "groupBy": "code", "from": "2026-11-01T00:00:00Z", "to": "2026-11-05T00:00:00Z", "filter": {} },
      "expected": { "rows": [
        { "key": "aaaaaaaaaaaaaaaa", "scans": 3, "uniqueSessions": 2, "signups": 1, "conversionRate": 0.5 },
